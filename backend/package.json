{
  "name": "offer-letter-generator-backend",
  "version": "1.0.0",
  "description": "Standalone AI-Powered Offer Letter Generator Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx src/prisma/seed.ts",
    "db:push": "prisma db push",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/test-runner.ts",
    "test:offers": "tsx src/tests/offer-apis.test.ts",
    "test:personas": "tsx src/tests/persona-verification.test.ts",
    "test:flow": "tsx src/tests/complete-flow.integration.test.ts",
    "test:all": "tsx src/tests/test-runner.ts && tsx src/tests/offer-apis.test.ts && tsx src/tests/persona-verification.test.ts && tsx src/tests/complete-flow.integration.test.ts"
  },
  "keywords": [
    "offer-letter",
    "ai",
    "rbac",
    "generator",
    "pdf"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.9",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
