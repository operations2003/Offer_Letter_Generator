# ==============================================================================
# AI-POWERED OFFER LETTER GENERATOR — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/offer_letter_generator?schema=public"

# Authentication & JWT Secrets (Use min 32 characters in production)
JWT_SECRET="dev_jwt_secret_super_secure_key_change_in_production_32chars_min"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_super_secure_key_change_in_production_32chars"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ==============================================================================
# AI PROVIDER CONFIGURATION (Swappable without code changes)
# Options: "GROQ" | "OLLAMA" | "OPENAI" | "MOCK"
# ==============================================================================
AI_PROVIDER="MOCK"
AI_MODEL="llama-3.3-70b-versatile"
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# 1. Groq Cloud (Free Open Source Models: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# 2. Local Ollama (Self-hosted Open Source Models: llama3, mistral, qwen2.5)
OLLAMA_BASE_URL="http://localhost:11434"

# 3. OpenAI / Compatible (OpenAI, DeepSeek, Together, vLLM)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
